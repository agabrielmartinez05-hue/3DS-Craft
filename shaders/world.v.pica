.fvec projection[4]
.fvec view[4]
.fvec sunDirection
.fvec lighting ; x=ambient, y=diffuse
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outPosition position
.out outColor color
.out outUv texcoord0
.alias inPosition v0
.alias inColor v1
.alias inNormal v2
.alias inUv v3
.proc main
    mov r0.xyz, inPosition
    mov r0.w, constants.y
    dp4 r1.x, view[0], r0
    dp4 r1.y, view[1], r0
    dp4 r1.z, view[2], r0
    dp4 r1.w, view[3], r0
    dp4 outPosition.x, projection[0], r1
    dp4 outPosition.y, projection[1], r1
    dp4 outPosition.z, projection[2], r1
    dp4 outPosition.w, projection[3], r1
    dp3 r2.x, sunDirection, inNormal
    max r2.x, constants.x, r2.x
    mul r2.x, lighting.y, r2.x
    add r2.x, lighting.x, r2.x
    mul outColor.xyz, inColor, r2.xxx
    mov outColor.w, constants.y
    mov outUv, inUv
    end
.end
